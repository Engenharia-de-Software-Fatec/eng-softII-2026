@startuml
title Diagrama de classes - Parte 1: Gestão e Documentos

left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho

abstract class Usuario {
  - id: int
  - nome: String
  - email: String
  - senha: String
  - ativo: boolean
  + autenticar(email: String, senha: String): boolean
  + recuperarSenha(): void
  + alterarSenha(novaSenha: String): void
}

class Administrador {
  + cadastrarContador(contador: Contador): void
  + desativarContador(contador: Contador): void
  + gerenciarAcessos(): void
}

class Contador {
  + cadastrarEmpresa(empresa: Empresa): void
  + gerenciarEmpresa(empresa: Empresa): void
  + cadastrarCliente(cliente: Cliente): void
  + gerenciarAcessoCliente(cliente: Cliente): void
  + cadastrarPlanoContas(plano: PlanoDeContas): void
  + enviarDocumento(documento: DocumentoFiscal): void
}

class Cliente {
  + enviarDocumento(documento: DocumentoFiscal): void
  + consultarDocumentos(): void
  + acompanharProcessamento(documento: DocumentoFiscal): String
}

class TokenRecuperacaoSenha {
  - id: int
  - token: String
  - dataExpiracao: DateTime
  - utilizado: boolean
  + validarToken(): boolean
  + utilizarToken(): void
}

class Empresa {
  - id: int
  - razaoSocial: String
  - cnpj: String
  - regimeTributario: String
  - ativo: boolean
  + atualizarDados(): void
  + ativar(): void
  + desativar(): void
}

class PlanoDeContas {
  - id: int
  - nome: String
  - dataCriacao: Date
  + adicionarConta(conta: ContaContabil): void
  + removerConta(conta: ContaContabil): void
  + importarPlano(arquivo: String): void
}

class ContaContabil {
  - id: int
  - codigo: String
  - descricao: String
  - tipo: String
  + atualizarDados(): void
}

class DocumentoFiscal {
  - id: int
  - nomeArquivo: String
  - formato: String
  - hashArquivo: String
  - chaveAcesso: String
  - dataEnvio: DateTime
  - status: String
  - justificativaRejeicao: String
  + validarArquivo(): boolean
  + verificarDuplicidade(): boolean
  + atualizarStatus(status: String): void
  + rejeitar(justificativa: String): void
}

class ProcessamentoDocumento {
  - id: int
  - tipoIdentificado: String
  - dadosExtraidos: String
  - dataInicio: DateTime
  - dataFim: DateTime
  - mensagemFalha: String
  + identificarTipo(): void
  + extrairDados(): void
  + gerarSugestao(): SugestaoLancamento
  + registrarFalha(mensagem: String): void
}

Usuario <|-- Administrador
Usuario <|-- Contador
Usuario <|-- Cliente

Usuario "1" -- "0..*" TokenRecuperacaoSenha : solicita

Administrador "1" -- "0..*" Contador : gerencia

Contador "0..*" -- "1..*" Empresa : administra
Empresa "1" -- "0..*" Cliente : possui acessos

Empresa "1" *-- "1" PlanoDeContas
PlanoDeContas "1" *-- "1..*" ContaContabil

Empresa "1" -- "0..*" DocumentoFiscal : recebe
Usuario "1" -- "0..*" DocumentoFiscal : envia

DocumentoFiscal "1" *-- "0..*" ProcessamentoDocumento : possui

@enduml
