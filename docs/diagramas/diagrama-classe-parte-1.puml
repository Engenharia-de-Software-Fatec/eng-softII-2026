@startuml
top to bottom direction

skinparam linetype ortho
skinparam classAttributeIconSize 0

abstract class Usuario {
    - id: int
    - nome: String
    - email: String
    - senha: String
    - ativo: boolean
    + autenticar(email: String, senha: String): boolean
    + recuperarSenha(): void
    + alterarSenha(novaSenha: String): void
}

class Administrador {
    + cadastrarContador(): void
    + desativarContador(): void
    + gerenciarAcessos(): void
}

class Contador {
    + cadastrarEmpresa(): void
    + gerenciarEmpresa(): void
    + cadastrarCliente(): void
    + gerenciarAcessoCliente(): void
    + cadastrarPlanoContas(): void
    + enviarDocumento(): void
}

class Cliente {
    + enviarDocumento(): void
    + consultarDocumentos(): void
    + acompanharProcessamento(): void
}

class TokenRecuperacaoSenha {
    - id: int
    - token: String
    - dataExpiracao: DateTime
    - utilizado: boolean
    + validarToken(): boolean
    + utilizarToken(): void
}

class Empresa {
    - id: int
    - razaoSocial: String
    - cnpj: String
    - regimeTributario: String
    - ativa: boolean
    + atualizarDados(): void
    + ativar(): void
    + desativar(): void
}

class PlanoDeContas {
    - id: int
    - descricao: String
    + adicionarConta(): void
    + removerConta(): void
    + importarPlano(): void
}

class ContaContabil {
    - id: int
    - codigo: String
    - descricao: String
    - tipo: String
    + atualizarDados(): void
}

class DocumentoFiscal {
    - id: int
    - nomeArquivo: String
    - formato: String
    - dataEnvio: DateTime
    - status: String
    - hashArquivo: String
    + validarArquivo(): boolean
    + verificarDuplicidade(): boolean
    + atualizarStatus(): void
    + rejeitar(justificativa: String): void
}

class ProcessamentoDocumento {
    - id: int
    - tipoDocumento: String
    - dadosExtraidos: String
    - confianca: double
    - status: String
    + identificarTipo(): void
    + extrairDados(): void
    + gerarSugestao(): void
    + registrarFalha(): void
}

Usuario <|-- Administrador
Usuario <|-- Contador
Usuario <|-- Cliente

Usuario "1" -- "0..*" TokenRecuperacaoSenha
Administrador "1" -- "0..*" Contador : gerencia
Contador "1" -- "0..*" Empresa : administra
Empresa "1" -- "0..*" Cliente : possui acessos

Empresa "1" *-- "1" PlanoDeContas
PlanoDeContas "1" *-- "1..*" ContaContabil

Empresa "1" -- "0..*" DocumentoFiscal : recebe
Usuario "1" -- "0..*" DocumentoFiscal : envia
DocumentoFiscal "1" *-- "0..1" ProcessamentoDocumento

@enduml
