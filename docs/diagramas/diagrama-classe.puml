
@startuml
title Contabilidade Ágil - Parte 1: Gestão e Documentos

left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho

abstract class Usuario {
  - id: int
  - nome: String
  - email: String
  - senha: String
  - ativo: boolean
}

class Administrador
class Contador
class Cliente

class TokenRecuperacaoSenha {
  - id: int
  - token: String
  - dataExpiracao: DateTime
  - utilizado: boolean
}

class Empresa {
  - id: int
  - razaoSocial: String
  - cnpj: String
  - regimeTributario: String
  - ativo: boolean
}

class PlanoDeContas {
  - id: int
  - nome: String
  - dataCriacao: Date
}

class ContaContabil {
  - id: int
  - codigo: String
  - descricao: String
  - tipo: String
}

class DocumentoFiscal {
  - id: int
  - nomeArquivo: String
  - formato: String
  - hashArquivo: String
  - chaveAcesso: String
  - dataEnvio: DateTime
  - status: String
}

class ProcessamentoDocumento {
  - id: int
  - tipoIdentificado: String
  - dadosExtraidos: String
  - dataInicio: DateTime
  - dataFim: DateTime
  - mensagemFalha: String
}

Usuario <|-- Administrador
Usuario <|-- Contador
Usuario <|-- Cliente

Usuario "1" -- "0..*" TokenRecuperacaoSenha : solicita

Administrador "1" -- "0..*" Usuario : gerencia

Contador "0..*" -- "1..*" Empresa : administra
Empresa "1" -- "0..*" Cliente : possui acessos

Empresa "1" *-- "1" PlanoDeContas
PlanoDeContas "1" *-- "1..*" ContaContabil

Empresa "1" -- "0..*" DocumentoFiscal : recebe
Usuario "1" -- "0..*" DocumentoFiscal : envia

DocumentoFiscal "1" *-- "0..*" ProcessamentoDocumento : possui

@enduml
